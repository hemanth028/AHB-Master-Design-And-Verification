module top;
	reg hclk;
	reg hresetn;
			
	ahb_env env;

	ahb_intf pif(hclk,hresetn);

ahb_master_top dut (
 .hclk(hclk),
 .hresetn(hresetn),
 .hready(pif.hready),
 .hresp(pif.hresp),
 .hgrant(pif.hgrant),
 .start(pif.start),

 .hwrite_in(pif.hwrite_in),
 .hburst(pif.hburst),
 .hsize(pif.hsize),
 .base_addr(pif.base_addr),

 .wr_data(pif.wr_data),
 .hrdata(pif.hrdata),

 .haddr(pif.haddr),
 .hwdata(pif.hwdata),
 .hwrite(pif.hwrite),
 .htrans(pif.htrans),
 .hburst_out(pif.hburst_out),
 .hsize_out(pif.hsize_out),
 .rd_data(pif.rd_data),
 .burst_done(pif.burst_done)
);

always #5 hclk=~hclk;
initial begin
	hclk=0;
	hresetn=0;
	#2;
	hresetn=1'b1;
end

initial begin
	env=new();
	env.run();

end

initial begin
	wait(ahb_common::tran_end);
	#5;
		if(ahb_common::mismatch!=0)
			$display("##### TEST FAILED: Match=%0d | Mismatch=%0d", ahb_common::match, ahb_common::mismatch);
		else
			$display("##### TEST PASSED: Match=%0d | Mismatch=%0d", ahb_common::match, ahb_common::mismatch);

		#2 $finish;
	
end
endmodule 

